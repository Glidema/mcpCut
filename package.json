{
  "name": "mcpcut",
  "version": "0.1.0",
  "description": "Agent-callable MCP video editor: inspect, timeline, preview, then render.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcpcut": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "smoke:phase1": "tsx scripts/smoke-phase1.ts",
    "smoke:phase2": "tsx scripts/smoke-phase2.ts",
    "smoke:phase3": "tsx scripts/smoke-phase3.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
